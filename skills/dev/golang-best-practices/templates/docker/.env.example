# 复制为项目自己的环境文件，再按 Go 版本与入口包调整。
# 这些值用于 Compose 插值；只有 compose.environment 中列出的值传入应用。
GO_IMAGE=golang:1.26.0-alpine
MAIN_PACKAGE=.
IMAGE_NAME=go-app
IMAGE_TAG=dev
APP_PORT=8080
HOST_PORT=8080

# 仅在显式启用 database profile 时配置。
POSTGRES_IMAGE=postgres:16-alpine
DB_USER=app
DB_NAME=app
DB_PASSWORD=

# 仅在显式启用 cache profile 时配置。
REDIS_IMAGE=redis:7-alpine
REDIS_PASSWORD=
